{
    "name": "openemr/oe-smart-questionnaire",
    "description": "Standalone SMART on FHIR app for completing FHIR Questionnaires against OpenEMR",
    "type": "project",
    "license": "GPL-3.0-only",
    "keywords": [
        "openemr",
        "fhir",
        "smart-on-fhir",
        "questionnaire",
        "sdc",
        "ehr"
    ],
    "homepage": "https://github.com/openemr/oe-smart-questionnaire",
    "authors": [
        {
            "name": "Jerry Padgett",
            "email": "sjpadgett@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/openemr/oe-smart-questionnaire/issues",
        "forum": "https://community.open-emr.org/",
        "source": "https://github.com/openemr/oe-smart-questionnaire"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OpenEMR\\SmartQuestionnaire\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "@php tests/lint.php",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse --no-progress",
        "test-unit": "@php tests/unit.php",
        "test-e2e": "@php tests/e2e.php",
        "test": [
            "@test-unit",
            "@test-e2e"
        ],
        "check": [
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "lint": "PHP syntax check of every file",
        "cs": "PSR-12 coding standard (phpcs)",
        "cs-fix": "Fix coding-standard violations (phpcbf)",
        "stan": "Static analysis (PHPStan level 8)",
        "test-unit": "Unit checks",
        "test-e2e": "End-to-end flow against the mock OpenEMR (runs the jsdom browser test when installed)",
        "test": "Unit and end-to-end tests",
        "check": "Everything CI runs"
    }
}
